# sreadvisor environment configuration.
#
# Copy this file to `.env` (already in .gitignore, so it is never committed) and fill in what you need.
# `sreadvisor` loads `.env` automatically on every run (see cli.py's `main()`), searching from the current
# directory upward, so this normally lives at the project root, next to pyproject.toml.
#
# Everything here can also be set as a real, exported environment variable instead (an already-exported variable
# always wins over the value in this file) or, for most of these, overridden per run with a CLI flag.

# ---------------------------------------------------------------------------------------------- output location
# Default output directory for `sreadvisor analyze` when neither --out nor the per-service config's output_dir is
# given. Leave unset to fall back to ./output (relative to wherever you run the command from).
SREADVISOR_OUTPUT_DIR=output

# ------------------------------------------------------------------------------------------- model backend switch
# Which LLM backend every ADK agent uses. One of: ollama | gemini | vertex. Overrides model.backend in the
# registry file (default_registry.yaml, or whatever --registry points at).
SREADVISOR_MODEL_BACKEND=ollama

# --- ollama (local development) ---
# The Ollama model name (must already be pulled: `ollama pull <name>`). Overrides model.ollama.model.
SREADVISOR_OLLAMA_MODEL=gemma4:latest
# Base URL of the Ollama server, if not the default local one.
OLLAMA_API_BASE=http://localhost:11434

# --- gemini (production-parity check) ---
# API key for the Gemini backend. The variable name itself is configurable (model.gemini.api_key_env in the
# registry); GEMINI_API_KEY is the default name, and GOOGLE_API_KEY is used as a fallback if that is unset.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- vertex (production deployment) ---
# Vertex uses Application Default Credentials, not a token here (run: gcloud auth application-default login).
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --------------------------------------------------------------------------------------- observability provider
# Dynatrace API token, read fresh at call time, never written to a dataset or the registry. The variable name is
# configurable per service (observability.options.api_token_env in a service's config); DT_API_TOKEN is the
# default name every example and template in this project uses.
# DT_API_TOKEN=

# The Dynatrace environment URL (e.g. https://abc12345.live.dynatrace.com) is NOT read from the environment: give
# it with --dt-environment-url, or observability.options.environment_url in the per-service config file. This is
# deliberate (see providers/dynatrace.py) so a wrong or stale value cannot silently come from a leftover .env.
# (DT_ENVIRONMENT is also NOT a setting to fill in here: it is set internally, per call, by DynatraceProvider when
# it spawns the MCP server subprocess, scoped to that one call — never read from your own environment.)

# ------------------------------------------------------------------------------------------------------- misc
# Path to an alternate registry.yaml (providers, NFR modules, output sinks, model/analysis settings), instead of
# the built-in default_registry.yaml. Equivalent to passing --registry on every command.
# SREADVISOR_REGISTRY=
