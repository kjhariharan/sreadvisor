# sreadvisor environment configuration.
#
# Copy this file to `.env` (already in .gitignore, so it is never committed) and fill in what you need.
# `sreadvisor` loads `.env` automatically on every run (see cli.py's `main()`), searching from the current
# directory upward, so this normally lives at the project root, next to pyproject.toml.
#
# Everything here can also be set as a real, exported environment variable instead (an already-exported variable
# always wins over the value in this file) or, for most of these, overridden per run with a CLI flag.

# ---------------------------------------------------------------------------------------------- output location
# Default output directory for `sreadvisor analyze` when neither --out nor the per-service config's output_dir is
# given. Leave unset to fall back to ./output (relative to wherever you run the command from).
SREADVISOR_OUTPUT_DIR=output

# ------------------------------------------------------------------------------------------- model backend switch
# Which LLM backend every ADK agent uses. One of: ollama | gemini | vertex | gateway. Overrides model.backend in
# the registry file (default_registry.yaml, or whatever --registry points at).
SREADVISOR_MODEL_BACKEND=ollama

# --- ollama (local development) ---
# The Ollama model name (must already be pulled: `ollama pull <name>`). Overrides model.ollama.model.
SREADVISOR_OLLAMA_MODEL=gemma4:latest
# Base URL of the Ollama server, if not the default local one.
OLLAMA_API_BASE=http://localhost:11434

# --- gemini (production-parity check) ---
# API key for the Gemini backend. The variable name itself is configurable (model.gemini.api_key_env in the
# registry); GEMINI_API_KEY is the default name, and GOOGLE_API_KEY is used as a fallback if that is unset.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- vertex (production deployment) ---
# Vertex uses Application Default Credentials, not a token here (run: gcloud auth application-default login).
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- gateway (a generic internal AI gateway: any provider it can route to — Anthropic, Gemini, OpenAI, ...) ---
# The gateway's own model name, in LiteLLM's "<provider>/<name>" form, e.g. openai/gpt-4o, anthropic/claude-sonnet-4-5,
# gemini/gemini-2.5-flash — overrides model.gateway.model.
# SREADVISOR_GATEWAY_MODEL=
# The gateway's own base URL — overrides model.gateway.api_base. Required for this backend; there is no default.
# AI_GATEWAY_API_BASE=
# API key for the gateway itself, if it needs one. The variable name is configurable (model.gateway.api_key_env);
# AI_GATEWAY_API_KEY is the default name.
# AI_GATEWAY_API_KEY=
# TLS for the gateway connection (model.gateway.ssl_verify / model.gateway.ca_cert_path in the registry, not env
# vars — a certificate setting is more of a fixed environment property than a per-run override): ssl_verify: false
# skips verification (e.g. a trusted internal endpoint with a self-signed cert); ca_cert_path names a CA bundle
# file to verify against when the gateway's certificate isn't already in the system trust store.

# --------------------------------------------------------------------------------------- observability provider
# Which auth mode Dynatrace uses is a per-service config setting (observability.options.auth_mode: api_token |
# oauth2, default api_token), or --dt-auth-mode on the CLI — not an env var, same reasoning as the environment URL
# below. Only the credentials themselves are read from the environment:

# auth_mode: api_token — the API token, read fresh at call time, never written to a dataset or the registry. The
# variable name is configurable per service (observability.options.api_token_env); DT_API_TOKEN is the default
# name every example and template in this project uses.
# DT_API_TOKEN=

# auth_mode: oauth2 — a client id/secret, exchanged for a short-lived bearer token via a client-credentials grant
# (see mcp_servers/dynatrace_server.py); the access token itself is cached only in memory, never here. Variable
# names are configurable per service (observability.options.oauth_client_id_env/oauth_client_secret_env);
# DT_OAUTH_CLIENT_ID/DT_OAUTH_CLIENT_SECRET are the default names.
# DT_OAUTH_CLIENT_ID=
# DT_OAUTH_CLIENT_SECRET=
# The token endpoint itself (observability.options.oauth_url) defaults to Dynatrace SSO and is set in config, not here.

# The Dynatrace environment URL (e.g. https://abc12345.live.dynatrace.com) is NOT read from the environment: give
# it with --dt-environment-url, or observability.options.environment_url in the per-service config file. This is
# deliberate (see providers/dynatrace.py) so a wrong or stale value cannot silently come from a leftover .env.
# (DT_ENVIRONMENT and DT_AUTH_MODE/DT_OAUTH_URL/DT_OAUTH_SCOPES are also NOT settings to fill in here: they are set
# internally, per call, by DynatraceProvider when it spawns the MCP server subprocess, scoped to that one call —
# never read from your own environment.)

# ------------------------------------------------------------------------------------------------------- misc
# Path to an alternate registry.yaml (providers, NFR modules, output sinks, model/analysis settings), instead of
# the built-in default_registry.yaml. Equivalent to passing --registry on every command.
# SREADVISOR_REGISTRY=
